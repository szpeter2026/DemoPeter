# szpeter2026 知识库 - 环境配置模板
# 复制此文件为 .env 并填入实际值

# === AI 模型配置 ===
# DeepSeek API（推荐）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Ollama 本地模型（备选，需先安装 Ollama）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2:latest

# 选择使用的 AI 提供商：deepseek 或 ollama
AI_PROVIDER=deepseek

# === 向量数据库配置（Docker 容器化）===
# 先启动 Docker 容器: .\scripts\manage.ps1 -Action docker-up
CHROMA_MODE=remote
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=szpeter2026_kb

# === pgvector 向量数据库配置（可选备选方案）===
PGVECTOR_ENABLED=true
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_USER=szpeter
PGVECTOR_PASSWORD=Szpeter2026!
PGVECTOR_DATABASE=szpeter2026
PGVECTOR_EMBEDDING_DIM=768

# === Ollama Embedding 模型（pgvector 向量化用）===
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# === 数据库配置 ===
# SQLite 元数据库（默认，无需配置）

# === Web 面板配置 ===
WEB_HOST=127.0.0.1
WEB_PORT=5200
WEB_DEBUG=false

# === 文档处理配置 ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# === Notion 集成（可选） ===
# NOTION_TOKEN=ntn_your_integration_secret
# NOTION_DATABASE_ID=your_database_id

# === Gitea Webhook（可选） ===
# GITEA_WEBHOOK_SECRET=your_webhook_secret
# GITEA_BASE_URL=http://your-gitea-server:3000

# === Outlook / Microsoft Graph OAuth2（可选） ===
# OUTLOOK_CLIENT_ID=your_azure_client_id
# OUTLOOK_CLIENT_SECRET=your_azure_client_secret
# OUTLOOK_REDIRECT_URI=http://localhost:5200/auth/outlook/callback
