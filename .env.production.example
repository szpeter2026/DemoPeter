# szpeter2026 - Environment Config Template
# Copy this file to .env.production and fill in your values:
#   cp .env.production.example .env.production

# === AI Model ===
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_PROVIDER=deepseek

# === Chroma (Docker remote mode) ===
CHROMA_MODE=remote
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=szpeter2026_kb

# === Search ===
SEARCH_MODE=hybrid
HYBRID_RRF_K=60

# === pgvector ===
PGVECTOR_ENABLED=false
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_USER=szpeter
PGVECTOR_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
PGVECTOR_DATABASE=szpeter2026
PGVECTOR_EMBEDDING_DIM=768

# === Ollama Embedding ===
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# === Web ===
WEB_HOST=0.0.0.0
WEB_PORT=5200
WEB_DEBUG=false

# === Document Processing ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
