# ============================================================
# szpeter2026 知识库 - 阿里云生产环境配置
# ============================================================
# 复制此文件为 .env.production 并填入真实值
# 注意: .env.production 不要提交到 Git！
# ============================================================

# === AI 模型配置 ===
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === Chroma 向量数据库（容器内通信） ===
CHROMA_MODE=remote
# 注意：Docker 内部用服务名 chroma，不是 localhost
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=szpeter2026_kb

# === pgvector（可选） ===
PGVECTOR_ENABLED=false
# 如果启用，连接地址用服务名
# PGVECTOR_ENABLED=true
# PGVECTOR_HOST=pgvector
# PGVECTOR_PORT=5432
# PGVECTOR_USER=szpeter
# PGVECTOR_PASSWORD=你的密码
# PGVECTOR_DATABASE=szpeter2026
# PGVECTOR_EMBEDDING_DIM=768

# === Web 面板 ===
# 容器内监听 0.0.0.0:5200，由 Nginx 反向代理
WEB_HOST=0.0.0.0
WEB_PORT=5200
WEB_DEBUG=false

# === 文档处理 ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# === 外部集成（按需填写） ===
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
# GITEA_WEBHOOK_SECRET=
# GITEA_BASE_URL=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_REDIRECT_URI=http://你的域名/auth/outlook/callback
